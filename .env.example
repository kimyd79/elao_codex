# Local development only. Copy this file to .env before starting.
POSTGRES_DB=mwla2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=local-development-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOW_ALL=True
DJANGO_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Leave empty to use EALO/backend/media for a native Windows installation.
DJANGO_MEDIA_ROOT=
DJANGO_LOG_TO_FILE=True
# Leave empty to use EALO/backend/logs.
DJANGO_LOG_DIR=
LOG_PARSER_SPLIT_SIZE_BYTES=1610612736
LOG_PARSER_MAX_EXPANDED_BYTES=10737418240
LOG_STORAGE_MODE=dynamic

VUE_APP_API_URL=http://127.0.0.1:8000/mwla

# Optional initial local administrator. Change these development defaults.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin
